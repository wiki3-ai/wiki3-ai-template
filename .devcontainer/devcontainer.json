{
    "name": "Wiki3 Template",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": [
        "--cpus=2",
        "--memory=6g"
    ],
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python"
            }
        }
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "JupyterLite",
            "protocol": "http",
            "onAutoForward": "openBrowserOnce",
            "requireLocalPort": true
        }
    },
    "containerEnv": {
        "JUPYTERLITE_PORT": "8000",
        "RESTARTABLE": "yes"
    },
    "postCreateCommand": "pip install -e .",
    "postStartCommand": "jupyter lite serve"
}